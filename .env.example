GOOGLE_CLOUD_PROJECT="your-new-project-id"
FIRESTORE_DATABASE_ID="milton"
GOOGLE_CLOUD_LOCATION="us-central1"
# The browser-facing origin. Discord matches the OAuth redirect URI exactly, so in local
# development this is the Vite origin (which proxies /auth and /api to the API port).
SERVICE_URL="http://localhost:5173"
LIVE_TASK_QUEUE="milton-live-extraction"
HISTORY_TASK_QUEUE="milton-history-extraction"
COMMAND_TASK_QUEUE="milton-commands"
TASK_SERVICE_ACCOUNT="milton-tasks@your-new-project-id.iam.gserviceaccount.com"
INTERNAL_SERVICE_ACCOUNTS="milton-tasks@your-new-project-id.iam.gserviceaccount.com,milton-scheduler@your-new-project-id.iam.gserviceaccount.com"
DISCORD_APPLICATION_ID="your-application-id"
DISCORD_CLIENT_SECRET="your-oauth-client-secret"
DISCORD_BOT_TOKEN="your-bot-token"
DISCORD_GUILD_ID="your-server-id"
DISCORD_PUBLIC_KEY="your-application-public-key"
ADMIN_DISCORD_USER_IDS="your-user-id"
SESSION_SECRET="generate-at-least-32-random-bytes"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-5.6-luna"
OPENROUTER_REASONING_EFFORT="medium"
ALLOW_UNAUTHENTICATED_INTERNAL="false"
