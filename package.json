{
  "name": "milton",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_WRITE_LOGS=0 vite dev",
    "build": "WRANGLER_WRITE_LOGS=0 vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && WRANGLER_WRITE_LOGS=0 wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:verify": "sqlite3 :memory: < migrations/0001_initial.sql",
    "check": "npm run typecheck && npm run test && npm run db:verify && npm run build",
    "db:migrate:local": "WRANGLER_WRITE_LOGS=0 wrangler d1 migrations apply milton --local",
    "db:migrate:remote": "WRANGLER_WRITE_LOGS=0 wrangler d1 migrations apply milton --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=22"
  }
}
